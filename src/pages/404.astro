---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { currentSite } from '../data/sites.mjs';
import { BRAND } from '../data/brand.mjs';

/**
 * The only route that lives in src/pages. Every site type needs it, so it does
 * not go through the route injection in integrations/site-routes.mjs.
 */
const site = currentSite();
const home = site.type === 'parked' ? '/' : '/';
---

<Base
  title="Page not found"
  description="That page does not exist."
  path="/404"
>
  <div class="page section">
    <div class="measure">
      <h1>We could not find that page</h1>
      <p class="lede">
        The address may have changed, or the link that brought you here may have
        a typo in it.
      </p>
      <p>
        If you were trying to tell us about your land, the home page has the form
        on it. If you would rather write to a person, use
        <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a> and we will pick it
        up from there.
      </p>
      <p style="margin-top: var(--s6)">
        <Button href={home}>Go to the home page</Button>
      </p>
    </div>
  </div>
</Base>
