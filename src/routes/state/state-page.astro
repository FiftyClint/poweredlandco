---
import Base from '../../layouts/Base.astro';
import FormSlot from '../../components/FormSlot.astro';
import Faq from '../../components/Faq.astro';
import { currentSite } from '../../data/sites.mjs';
import { faqPageSchema, breadcrumbSchema } from '../../lib/schema.mjs';
import { statePath } from '../../lib/nav.mjs';

/**
 * The state page. This is the page the whole site exists to rank.
 *
 * Order matters here and it is deliberate. The first version of this page led
 * with utility territories and incentive statutes, which is what an
 * infrastructure person finds interesting. It is not what the person who owns
 * the ground came to find out.
 *
 * So it now runs in the order landowners actually ask: what is it worth, can I
 * keep using it, what will it do to my place, is whoever contacted me real.
 * Utilities and incentives are still here, because they are genuine
 * differentiation and they help the page get found, but they sit below the
 * questions people actually have.
 *
 * The direct answer stays first and has to land inside the first 150 words.
 * Every word comes from the state data file.
 */
const site = currentSite();
const path = statePath(site);

const utilityGroups = [
  { kind: 'investor-owned', label: 'Investor owned utilities' },
  { kind: 'cooperative', label: 'Rural electric cooperatives' },
  { kind: 'municipal', label: 'Municipal utilities' },
  { kind: 'generation', label: 'Generation and transmission' },
]
  .map((group) => ({
    ...group,
    items: site.utilities.filter((u) => u.kind === group.kind),
  }))
  .filter((group) => group.items.length > 0);
---

<Base
  title={`How to Sell Your Land for a Data Center in ${site.stateName}`}
  description={`A plain answer for ${site.stateName} landowners: what your land could be worth and why, whether you can keep farming it, what a project actually does to your place, and how to tell a real buyer from a letter.`}
  path={path}
  schemas={[
    faqPageSchema(site, site.faq),
    breadcrumbSchema(site, [
      { label: 'Home', path: '/' },
      { label: site.stateName, path },
    ]),
  ]}
>
  <div class="page section">
    <p class="eyebrow">{site.stateName}</p>
    <h1 class="measure">
      How to sell your land for a data center in {site.stateName}
    </h1>
    <p class="lede measure">{site.directAnswer}</p>
  </div>

  <div class="page section--tight">
    <div class="split">
      <div class="split__main stack-lg">
        {/* First, because it is the first thing anyone asks. */}
        <section aria-labelledby="value-heading">
          <h2 id="value-heading">What your land could be worth</h2>
          <p>{site.value.intro}</p>
          <div class="answers">
            {
              site.value.points.map((point) => (
                <article class="answer">
                  <h3>{point.title}</h3>
                  <p>{point.body}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section aria-labelledby="living-heading">
          <h2 id="living-heading">What it means for your place</h2>
          <div class="answers">
            {
              site.livingWithIt.map((point) => (
                <article class="answer">
                  <h3>{point.title}</h3>
                  <p>{point.body}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section aria-labelledby="faq-heading">
          <h2 id="faq-heading">Questions from {site.stateName} landowners</h2>
          <Faq entries={site.faq} level={3} />
        </section>

        <hr />

        {/*
          Below the rule: useful reference, and part of why this page gets
          found, but not what brought anyone here.
        */}
        <section aria-labelledby="utilities-heading">
          <h2 id="utilities-heading">Who provides power in {site.stateName}</h2>
          <p>{site.utilitiesNote}</p>
          {
            utilityGroups.map((group) => (
              <div class="utility-group">
                <h3>{group.label}</h3>
                <ul class="utility-list">
                  {group.items.map((utility) => (
                    <li>
                      <span class="utility-list__name">{utility.name}</span>
                      {utility.note && <span class="muted"> {utility.note}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </section>

        <section aria-labelledby="incentives-heading">
          <h2 id="incentives-heading">
            Where {site.stateName} stands on data center incentives
          </h2>
          <p>{site.incentives.summary}</p>
          <p class="small muted">
            Programs change. Confirm anything that matters to your decision with
            your own advisor before acting on it.
          </p>
          <details class="sources">
            <summary>Sources for this section</summary>
            <ul>
              {
                site.incentives.sources.map((source) => (
                  <li>
                    <a href={source.url} rel="nofollow noopener">
                      {source.label}
                    </a>
                    <span class="small muted"> checked {source.accessed}</span>
                  </li>
                ))
              }
            </ul>
          </details>
        </section>

        <section aria-labelledby="regions-heading">
          <h2 id="regions-heading">
            Parts of {site.stateName} we watch most closely
          </h2>
          <div class="regions">
            {
              site.regions.map((region) => (
                <article class="card">
                  <h3>{region.title}</h3>
                  <p>{region.body}</p>
                </article>
              ))
            }
          </div>
        </section>
      </div>

      <aside class="split__aside">
        <FormSlot heading={`See if your ${site.stateName} land qualifies`} />
      </aside>
    </div>
  </div>
</Base>

<style>
  .split {
    display: grid;
    gap: var(--s7);
  }

  @media (min-width: 64rem) {
    .split {
      grid-template-columns: 1fr 24rem;
      align-items: start;
    }

    .split__aside {
      position: sticky;
      top: var(--s5);
    }
  }

  .split__main {
    max-width: 42rem;
  }

  .answers {
    display: grid;
    gap: var(--s5);
    margin-top: var(--s5);
  }

  .answer {
    padding-left: var(--s5);
    border-left: 3px solid var(--accent-tint);
  }

  .answer h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--s2);
  }

  .answer p {
    margin-bottom: 0;
  }

  .utility-group {
    margin-top: var(--s5);
  }

  .utility-group h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--s2);
  }

  .utility-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .utility-list li {
    padding: var(--s2) 0;
    border-bottom: 1px solid var(--rule);
  }

  .utility-list__name {
    font-weight: 600;
  }

  .regions {
    display: grid;
    gap: var(--s4);
    margin-top: var(--s5);
  }

  .sources {
    margin-top: var(--s4);
  }

  .sources summary {
    cursor: pointer;
    font-weight: 600;
    padding: var(--s2) 0;
  }

  .sources ul {
    padding-left: var(--s5);
  }

  .sources li {
    margin-bottom: var(--s2);
  }
</style>
