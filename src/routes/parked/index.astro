---
import '../../styles/global.css';
import Wordmark from '../../components/Wordmark.astro';
import FormSlot from '../../components/FormSlot.astro';
import { currentSite, siteUrl } from '../../data/sites.mjs';
import { BRAND, LEGAL_POSITIONING } from '../../data/brand.mjs';
import { organizationSchema } from '../../lib/schema.mjs';

/**
 * The entire site for a state we hold but have not built out.
 *
 * One page, brand, and the intake form. Deliberately not built on the full
 * layout: there is no navigation because there is nowhere to navigate to, and a
 * header full of dead links would be worse than none.
 *
 * The form is the point. An earlier version of this page offered an email
 * address and explained that we were still studying the state, which meant four
 * live domains collected nothing and told every visitor we were not ready. A
 * landowner who arrives here can now say what they have in the same way they
 * could on a full state site, and it lands in the same database. Which states
 * are worth building out properly is then a question the submissions answer.
 *
 * FormSlot carries its own data-boilerplate marker, so the duplicate copy
 * checker ignores it and the only text compared across these pages is the
 * per-state intro, which is the part that has to differ.
 */
const site = currentSite();
const title = `${BRAND.name} | ${site.stateName}`;
const description = `${BRAND.name} buys and options rural land in ${site.stateName} for data center development. Tell us about your property and we will look at it.`;
---

<!doctype html>
<html
  lang="en"
  style={`--accent:${site.palette.base};--accent-dark:${site.palette.dark};--accent-tint:${site.palette.tint}`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl(site)} />
    <link
      rel="preload"
      href="/fonts/source-sans-3-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl(site)} />
    <meta property="og:site_name" content={BRAND.name} />
    <meta name="theme-color" content={site.palette.base} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema(site))}
    />
  </head>

  <body class="parked">
    <main class="parked__inner">
      <Wordmark size="lg" />

      <h1>{site.stateName}</h1>

      <p class="lede">{site.intro}</p>

      <FormSlot id="qualify" heading="Tell us about your land" />
    </main>

    <!--
      The hub link and the positioning sentence live outside <main> because they
      are chrome, identical on every site by design. On a full site they sit in
      the footer for the same reason. Keeping them out of <main> is also what
      lets scripts/check-duplicate-copy.mjs compare the parts of these four
      pages that are actually supposed to differ.
    -->
    <footer class="parked__footer">
      <p class="small">
        <a href={`https://${BRAND.hubDomain}`}>Visit {BRAND.name}</a>
      </p>
      <p class="parked__legal small">{LEGAL_POSITIONING}</p>
    </footer>
  </body>
</html>

<style>
  .parked {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--s7);
    padding: var(--s7) var(--s5);
  }

  .parked__inner,
  .parked__footer {
    width: 100%;
    max-width: 34rem;
  }

  .parked__inner h1 {
    margin-top: var(--s6);
  }

  .parked__inner :global(.form-slot) {
    margin-top: var(--s6);
  }

  .parked__legal {
    margin-top: var(--s7);
    padding-top: var(--s5);
    border-top: 1px solid var(--rule);
    color: var(--ink-muted);
  }
</style>
