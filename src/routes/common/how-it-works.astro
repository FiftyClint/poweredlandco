---
import Base from '../../layouts/Base.astro';
import StepList from '../../components/StepList.astro';
import FormSlot from '../../components/FormSlot.astro';
import { currentSite } from '../../data/sites.mjs';
import { PROCESS_STEPS } from '../../data/process.mjs';
import { breadcrumbSchema } from '../../lib/schema.mjs';

const site = currentSite();
const copy = site.pageCopy.howItWorks;
const where = site.type === 'hub' ? '' : ` in ${site.stateName}`;

// Shared labels, per-site prose. See src/data/process.mjs for why.
const steps = PROCESS_STEPS.map((title, index) => ({
  title,
  body: copy.steps[index],
}));
---

<Base
  title={`How It Works | Selling land for a data center${where}`}
  description={`What happens after you contact us about your${where || ' rural'} land: how we screen it against public records, when we call, and how we decide whether to make an offer.`}
  path="/how-it-works"
  schemas={[
    breadcrumbSchema(site, [
      { label: 'Home', path: '/' },
      { label: 'How It Works', path: '/how-it-works' },
    ]),
  ]}
>
  <div class="page section">
    <p class="eyebrow">How it works</p>
    <h1 class="measure">What happens after you contact us</h1>
    <p class="lede measure">{copy.intro}</p>
  </div>

  <div class="page section--tight">
    <StepList steps={steps} level={2} />
  </div>

  <div class="page section">
    <p class="measure">{copy.closing}</p>
  </div>

  <div class="page section--tight">
    <div class="form-wrap">
      <FormSlot heading="Ready to find out?" />
    </div>
  </div>
</Base>

<style>
  .form-wrap {
    max-width: 44rem;
  }
</style>
