---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import { currentSite } from '../../data/sites.mjs';
import { BRAND } from '../../data/brand.mjs';

/**
 * Where the fallback form lands when JavaScript is unavailable and the webhook
 * redirects here. With JavaScript on, the visitor never sees this page: the
 * confirmation appears inline instead.
 *
 * Excluded from the sitemap because it is a destination, not a page anyone
 * should find in search.
 */
const site = currentSite();
---

<Base
  title="Thank you"
  description="We received your information and will be in touch."
  path="/thank-you"
>
  <div class="page section">
    <div class="measure">
      <h1>Thank you</h1>
      <p class="lede">
        We have your information. Someone here will look at your property
        against public records and get back to you, usually within a few days.
      </p>
      <p>
        If it turns out your land does not fit what we need, we will tell you
        that plainly rather than leave you wondering. Either way you will hear
        from us.
      </p>
      <p>
        If you thought of something after you sent the form, just reply to
        <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a> and it will reach the
        same person.
      </p>
      <p style="margin-top: var(--s6)">
        <Button href="/" variant="secondary">Back to the home page</Button>
      </p>
    </div>
  </div>
</Base>
